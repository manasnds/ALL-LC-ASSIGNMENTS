#include <stdio.h>
#include <string.h>


struct Sensor
{
    int   id;
    char  type[15];     /* Temperature, Humidity, Voltage, Current */
    float reading;      /* Measured value */
    float minLimit;     /* Preset minimum */
    float maxLimit;     /* Preset maximum */
    int   status;       /* 1 = Normal, 0 = Abnormal */
};


void setRange(struct Sensor *p, int choice);
void acceptSensors(struct Sensor *s, int n);
void displaySensors(struct Sensor *s, int n);
void checkReadings(struct Sensor *s, int n);
void calculateAverage(struct Sensor *s, int n);
void displayAbnormal(struct Sensor *s, int n);

int main()
{
    struct Sensor s[50];
    int n;

    printf("Enter the number of sensors: ");
    scanf("%d", &n);

    acceptSensors(s, n);        /* Accept details of n sensors */
    checkReadings(s, n);        /* Classify normal / abnormal */
    displaySensors(s, n);       /* Display all records */
    calculateAverage(s, n);     /* Average for selected type */
    displayAbnormal(s, n);      /* Abnormal sensors using pointer */

    return 0;
}

void setRange(struct Sensor *p, int choice)
{
    switch (choice)
    {
        case 1:
            strcpy(p->type, "Temperature");
            p->minLimit = 20;   p->maxLimit = 80;
            break;
        case 2:
            strcpy(p->type, "Humidity");
            p->minLimit = 30;   p->maxLimit = 70;
            break;
        case 3:
            strcpy(p->type, "Voltage");
            p->minLimit = 200;  p->maxLimit = 240;
            break;
        case 4:
            strcpy(p->type, "Current");
            p->minLimit = 1;    p->maxLimit = 10;
            break;
        default:
            printf("Invalid choice! Treating as Temperature.\n");
            strcpy(p->type, "Temperature");
            p->minLimit = 20;   p->maxLimit = 80;
    }
}


void acceptSensors(struct Sensor *s, int n)
{
    int i, choice;
    struct Sensor *p = s;

    for (i = 0; i < n; i++, p++)
    {
        printf(" Sensor %d \n", i + 1);
        printf("Enter Sensor ID: ");
        scanf("%d", &p->id);

        printf("Select Sensor Type\n");
        printf("1. Temperature\n2. Humidity\n3. Voltage\n4. Current\n");
        printf("Enter choice (1-4): ");
        scanf("%d", &choice);
        setRange(p, choice);

        printf("Enter Reading: ");
        scanf("%f", &p->reading);
    }
}


void checkReadings(struct Sensor *s, int n)
{
    struct Sensor *p;

    for (p = s; p < s + n; p++)
    {
        if (p->reading >= p->minLimit && p->reading <= p->maxLimit)
            p->status = 1;      /* Normal */
        else
            p->status = 0;      /* Abnormal */
    }
}


void displaySensors(struct Sensor *s, int n)
{
    struct Sensor *p;

    printf("\n SENSOR RECORDS \n");
    printf("%-5s %-13s %-9s %-7s %-7s %-9s\n",
           "ID", "Type", "Reading", "Min", "Max", "Status");
    printf("------------------------------------------------------------\n");

    for (p = s; p < s + n; p++)
    {
        printf("%-5d %-13s %-9.2f %-7.1f %-7.1f %-9s\n",
               p->id, p->type, p->reading, p->minLimit, p->maxLimit,
               p->status == 1 ? "NORMAL" : "ABNORMAL");
    }
}

/* Calculates average reading for a selected sensor type */
void calculateAverage(struct Sensor *s, int n)
{
    struct Sensor *p;
    struct Sensor temp;         /* used only to get the type name */
    int choice, count = 0;
    float sum = 0, avg;

    printf("\n\nSelect sensor type to find average\n");
    printf("1. Temperature\n2. Humidity\n3. Voltage\n4. Current\n");
    printf("Enter choice (1-4): ");
    scanf("%d", &choice);
    setRange(&temp, choice);

    for (p = s; p < s + n; p++)
    {
        if (strcmp(p->type, temp.type) == 0)
        {
            sum = sum + p->reading;
            count++;
        }
    }

    if (count == 0)
    {
        printf("No %s sensor found.\n", temp.type);
    }
    else
    {
        avg = sum / count;
        printf("Number of %s sensors = %d\n", temp.type, count);
        printf("Average %s reading = %.2f\n", temp.type, avg);
    }
}

/* Displays abnormal sensors using pointer traversal */
void displayAbnormal(struct Sensor *s, int n)
{
    struct Sensor *p;
    int count = 0;

    printf("\n========== ABNORMAL SENSORS ==========\n");
    for (p = s; p < s + n; p++)
    {
        if (p->status == 0)
        {
            printf("ID: %d, Type: %s, Reading: %.2f (Allowed: %.1f to %.1f)\n",
                   p->id, p->type, p->reading, p->minLimit, p->maxLimit);
            count++;
        }
    }

    if (count == 0)
        printf("All sensors are normal.\n");
    printf("Total abnormal sensors = %d\n", count);
}
